  "circuit_descriptions": {
    "R0-p(R1,CPE1)": {
      "name": "Randles cell with CPE",
      "n_params": 4,
      "param_names": ["R0", "R1", "CPE1_Q", "CPE1_n"],
      "interpretation": "R0=electrolyte, R1=charge transfer, CPE=double layer",
      "use_when": "Single depressed semicircle, uniform surface",
      "param_bounds": {
        "R0": [0, "inf"],
        "R1": [0, "inf"],
        "CPE1_Q": [0, "inf"],
        "CPE1_n": [0, 1]
      }
    },
    "R0-p(R1,CPE1)-W1": {
      "name": "Randles cell with Warburg",
      "n_params": 5,
      "param_names": ["R0", "R1", "CPE1_Q", "CPE1_n", "W1"],
      "interpretation": "R0=electrolyte, R1=charge transfer, CPE=double layer, W=diffusion",
      "use_when": "Semicircle + low-frequency linear tail (45°)",
      "param_bounds": {
        "R0": [0, "inf"],
        "R1": [0, "inf"],
        "CPE1_Q": [0, "inf"],
        "CPE1_n": [0, 1],
        "W1": [0, "inf"]
      }
    },
    "R0-p(R1,CPE1)-p(R2,CPE2)": {
      "name": "Two time-constant model",
      "n_params": 7,
      "param_names": ["R0", "R1", "CPE1_Q", "CPE1_n", "R2", "CPE2_Q", "CPE2_n"],
      "interpretation": "Two overlapping processes (e.g. charge transfer + adsorption/film)",
      "use_when": "Two partially overlapping arcs, If/Ib < 1",
      "param_bounds": {
        "R0": [0, "inf"],
        "R1": [0, "inf"],
        "CPE1_Q": [0, "inf"],
        "CPE1_n": [0, 1],
        "R2": [0, "inf"],
        "CPE2_Q": [0, "inf"],
        "CPE2_n": [0, 1]
      }
    }
  }
