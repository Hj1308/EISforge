      "note": "Best catalyst for ethanol oxidation — promotes C-C bond breaking",
      "electrolytes": {
        "acidic": {
          "EIS_parameters": {
            "R_solution": {"min": 1.0,  "max": 12.0,  "unit": "Ω"},
            "R_ct":       {"min": 15.0, "max": 600.0, "unit": "Ω"},
            "CPE_Q":      {"min": 1e-5, "max": 5e-3,  "unit": "F·s^(n-1)"},
            "CPE_n":      {"min": 0.78, "max": 0.93,  "unit": "dimensionless"}
          },
          "CV_parameters": {
            "E_onset_ethanol": {"min": 0.25, "max": 0.45, "unit": "V vs RHE"},
            "If_Ib_ratio":     {"min": 1.2,  "max": 2.8},
            "E_forward_peak":  {"min": 0.55, "max": 0.75, "unit": "V vs RHE"}
          },
          "recommended_circuit": "R0-p(R1,CPE1)-p(R2,CPE2)",
          "CO_poisoning_risk": "LOW-MEDIUM"
        }
      }
    },

    "Battery_LIB": {
      "system_type": "Battery",
      "chemistry": "Lithium-Ion",
      "variants": ["LFP", "NMC", "NCA", "LCO", "Graphite anode"],
      "electrolytes": {
        "organic_carbonate": {
          "examples": ["1M LiPF6 in EC:DMC", "1M LiPF6 in EC:DEC"],
          "EIS_parameters": {
            "R_ohmic":    {"min": 0.5,  "max": 10.0,  "unit": "Ω",   "note": "electrolyte + contacts"},
            "R_SEI":      {"min": 2.0,  "max": 50.0,  "unit": "Ω",   "note": "SEI layer resistance"},
            "C_SEI":      {"min": 1e-6, "max": 1e-4,  "unit": "F",   "note": "SEI capacitance"},
            "R_ct":       {"min": 5.0,  "max": 200.0, "unit": "Ω",   "note": "charge transfer at electrode"},
            "CPE_dl":     {"min": 1e-5, "max": 1e-3,  "unit": "F·s^(n-1)"},
            "CPE_n":      {"min": 0.70, "max": 0.95},
            "Warburg_sigma": {"min": 20.0, "max": 500.0, "unit": "Ω·s^-0.5", "note": "Li+ diffusion in electrode"}
          },
          "recommended_circuit": "R0-p(R1,C1)-p(R2,CPE1)-W1",
          "SOH_indicators": {
            "R_ct_increase_pct_per_cycle": {"min": 0.01, "max": 0.5, "note": "aging indicator"},
            "Warburg_increase": "indicates reduced Li diffusivity with aging"
          },
          "references": ["Osaka et al., J. Electrochem. Soc. 150 (2003) A334"]
        }
      }
    },

    "Corrosion_Steel": {
      "system_type": "Corrosion",
      "material": "Carbon Steel",
      "variants": ["mild steel", "stainless steel 304", "stainless steel 316"],
      "electrolytes": {
        "NaCl": {
          "examples": ["3.5% NaCl", "0.1M NaCl"],
          "EIS_parameters": {
            "R_solution": {"min": 1.0,  "max": 50.0,  "unit": "Ω"},
            "R_ct":       {"min": 100.0,"max": 1e6,   "unit": "Ω",   "note": "high = passive, low = active corrosion"},
            "CPE_Q":      {"min": 1e-6, "max": 1e-3,  "unit": "F·s^(n-1)"},
            "CPE_n":      {"min": 0.60, "max": 0.90},
            "R_film":     {"min": 10.0, "max": 10000.0,"unit": "Ω",  "note": "passive oxide film"},
            "C_film":     {"min": 1e-7, "max": 1e-4,  "unit": "F"}
          },
          "recommended_circuit": "R0-p(R1,CPE1)",
          "alternative_circuits": ["R0-p(R1,C1)-p(R2,CPE1)"],
          "corrosion_rate_indicators": {
            "R_ct_low":  "< 1000 Ω → active corrosion",
            "R_ct_high": "> 100000 Ω → passive/protected"
          }
        }
      }
    },

