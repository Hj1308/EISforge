  "circuit_descriptions": {
    "R0-p(R1,C1)": {
      "name": "Simple Randles",
      "elements": {"R0": "solution resistance", "R1": "charge transfer resistance", "C1": "ideal double layer capacitance"},
      "suitable_for": ["fresh catalysts", "simple interfaces", "preliminary analysis"],
      "nyquist_shape": "single semicircle"
    },
    "R0-p(R1,CPE1)": {
      "name": "Randles with CPE",
      "elements": {"R0": "solution resistance", "R1": "charge transfer resistance", "CPE1_Q": "CPE prefactor", "CPE1_n": "CPE exponent (0.5-1)"},
      "suitable_for": ["rough surfaces", "polycrystalline electrodes", "most real systems"],
      "nyquist_shape": "depressed semicircle"
    },
    "R0-p(R1,CPE1)-W1": {
      "name": "Randles + Warburg",
      "elements": {"W1": "semi-infinite Warburg (diffusion)"},
      "suitable_for": ["diffusion-limited reactions", "low substrate concentration", "fast kinetics"],
      "nyquist_shape": "depressed semicircle + 45° Warburg tail"
    },
    "R0-p(R1,CPE1)-p(R2,CPE2)": {
      "name": "Two Time Constants",
      "elements": {"R2": "second process resistance", "CPE2": "second process capacitance"},
      "suitable_for": ["CO poisoning in AOR", "SEI + charge transfer in batteries", "oxide film + reaction"],
      "nyquist_shape": "two overlapping semicircles"
    },
    "R0-p(R1,C1)-p(R2,CPE1)": {
      "name": "Oxide Film + Reaction",
      "suitable_for": ["Pd in alkaline AOR", "passive metals", "filmed electrodes"],
      "nyquist_shape": "small high-f arc + large low-f arc"
    }
  }
}
