{
  "_metadata": {
    "title": "EISForge Literature Knowledge Base",
    "author": "Hoda Jafari",
    "version": "1.0.0",
    "date": "May 2026",
    "description": "Curated electrochemical parameters from peer-reviewed literature",
    "note": "All values are literature ranges. Actual values depend on experimental conditions."
  },

  "systems": {

    "AOR_Pt": {
      "system_type": "AOR",
      "catalyst": "Pt",
      "variants": ["Pt/C", "Pt-black", "Pt bulk", "Pt nanoparticles"],
      "alcohols": ["methanol", "ethanol", "ethylene_glycol", "glycerol"],
      "electrolytes": {
        "acidic": {
          "examples": ["0.5M H2SO4", "0.1M HClO4"],
          "EIS_parameters": {
            "R_solution": {"min": 1.0,  "max": 15.0,  "unit": "Ω",          "note": "depends on electrolyte concentration"},
            "R_ct":       {"min": 20.0, "max": 2000.0,"unit": "Ω",          "note": "strongly potential-dependent"},
            "CPE_Q":      {"min": 1e-5, "max": 5e-3,  "unit": "F·s^(n-1)", "note": "related to ECSA"},
            "CPE_n":      {"min": 0.80, "max": 0.95,  "unit": "dimensionless"},
            "Warburg_sigma": {"min": 10.0, "max": 300.0, "unit": "Ω·s^-0.5", "note": "present at low concentrations"}
          },
          "CV_parameters": {
            "E_onset_methanol":       {"min": 0.45, "max": 0.65, "unit": "V vs RHE"},
            "E_onset_ethanol":        {"min": 0.40, "max": 0.60, "unit": "V vs RHE"},
            "If_Ib_ratio":            {"min": 0.5,  "max": 1.2,  "note": "Pt susceptible to CO poisoning"},
            "E_forward_peak_methanol":{"min": 0.65, "max": 0.90, "unit": "V vs RHE"},
            "E_backward_peak":        {"min": 0.40, "max": 0.60, "unit": "V vs RHE"}
          },
          "recommended_circuit": "R0-p(R1,CPE1)-W1",
          "alternative_circuits": ["R0-p(R1,CPE1)-p(R2,CPE2)", "R0-p(R1,CPE1)"],
          "CO_poisoning_risk": "HIGH",
          "references": [
            "Antolini, J. Power Sources 170 (2007) 1-12",
            "Lamy et al., Electrochim. Acta 47 (2002) 3701"
          ]
        },
        "alkaline": {
          "examples": ["1M KOH", "1M NaOH"],
          "EIS_parameters": {
            "R_solution": {"min": 0.5,  "max": 8.0,   "unit": "Ω"},
            "R_ct":       {"min": 5.0,  "max": 500.0, "unit": "Ω",          "note": "lower than acidic"},
            "CPE_Q":      {"min": 5e-5, "max": 1e-2,  "unit": "F·s^(n-1)"},
            "CPE_n":      {"min": 0.78, "max": 0.95,  "unit": "dimensionless"},
            "Warburg_sigma": {"min": 5.0, "max": 150.0, "unit": "Ω·s^-0.5"}
          },
          "CV_parameters": {
            "E_onset_methanol": {"min": 0.20, "max": 0.40, "unit": "V vs RHE"},
            "E_onset_ethanol":  {"min": 0.15, "max": 0.35, "unit": "V vs RHE"},
            "If_Ib_ratio":      {"min": 0.8,  "max": 2.0,  "note": "better than acidic"},
            "E_forward_peak":   {"min": 0.60, "max": 0.80, "unit": "V vs RHE"}
          },
          "recommended_circuit": "R0-p(R1,CPE1)-W1",
          "CO_poisoning_risk": "MEDIUM",
          "references": ["Spendelow & Wieckowski, Phys. Chem. Chem. Phys. 9 (2007) 2654"]
        }
      }
    },

    "AOR_Pd": {
      "system_type": "AOR",
      "catalyst": "Pd",
      "variants": ["Pd/C", "Pd-black", "Pd nanoparticles"],
      "alcohols": ["methanol", "ethanol", "ethylene_glycol", "glycerol"],
      "electrolytes": {
        "acidic": {
          "EIS_parameters": {
            "R_solution": {"min": 1.0,  "max": 15.0,  "unit": "Ω"},
            "R_ct":       {"min": 50.0, "max": 5000.0,"unit": "Ω",          "note": "Pd less active than Pt in acid"},
            "CPE_Q":      {"min": 1e-5, "max": 3e-3,  "unit": "F·s^(n-1)"},
            "CPE_n":      {"min": 0.75, "max": 0.92,  "unit": "dimensionless"},
            "R_oxide":    {"min": 1.0,  "max": 50.0,  "unit": "Ω",          "note": "PdO film at high potential"},
            "C_oxide":    {"min": 1e-4, "max": 5e-2,  "unit": "F",          "note": "oxide capacitance"}
          },
          "CV_parameters": {
            "E_onset_ethanol": {"min": 0.50, "max": 0.75, "unit": "V vs RHE"},
            "If_Ib_ratio":     {"min": 0.3,  "max": 0.8,  "note": "poor in acidic"},
            "E_forward_peak":  {"min": 0.70, "max": 0.95, "unit": "V vs RHE"}
          },
          "recommended_circuit": "R0-p(R1,C1)-p(R2,CPE1)",
          "note": "Pd shows oxide film arc at high frequencies in acidic",
          "CO_poisoning_risk": "VERY HIGH"
        },
        "alkaline": {
          "EIS_parameters": {
            "R_solution": {"min": 0.5,  "max": 8.0,   "unit": "Ω"},
            "R_ct":       {"min": 3.0,  "max": 200.0, "unit": "Ω",          "note": "Pd very active in alkaline!"},
            "CPE_Q":      {"min": 1e-4, "max": 2e-2,  "unit": "F·s^(n-1)"},
            "CPE_n":      {"min": 0.80, "max": 0.96,  "unit": "dimensionless"},
            "R_oxide":    {"min": 0.5,  "max": 20.0,  "unit": "Ω"},
            "C_oxide":    {"min": 5e-4, "max": 0.1,   "unit": "F"}
          },
          "CV_parameters": {
            "E_onset_ethanol":       {"min": 0.10, "max": 0.30, "unit": "V vs RHE"},
            "E_onset_ethylene_glycol":{"min": 0.05, "max": 0.25, "unit": "V vs RHE"},
            "If_Ib_ratio":           {"min": 1.5,  "max": 4.0,  "note": "excellent in alkaline!"},
            "E_forward_peak":        {"min": 0.55, "max": 0.75, "unit": "V vs RHE"}
          },
          "recommended_circuit": "R0-p(R1,C1)-p(R2,CPE1)",
          "CO_poisoning_risk": "LOW",
          "references": [
            "Xu et al., J. Power Sources 196 (2011) 4419",
            "Zhao et al., J. Power Sources 184 (2008) 206"
          ]
        }
      }
    },

    "AOR_PtRu": {
      "system_type": "AOR",
      "catalyst": "PtRu",
      "variants": ["PtRu/C", "PtRu alloy", "PtRu (1:1)", "PtRu (3:1)"],
      "note": "Best catalyst for methanol oxidation in acidic — bifunctional mechanism",
      "electrolytes": {
        "acidic": {
          "EIS_parameters": {
            "R_solution": {"min": 1.0,  "max": 12.0,  "unit": "Ω"},
            "R_ct":       {"min": 10.0, "max": 500.0, "unit": "Ω",  "note": "much lower than pure Pt!"},
            "CPE_Q":      {"min": 2e-5, "max": 8e-3,  "unit": "F·s^(n-1)"},
            "CPE_n":      {"min": 0.78, "max": 0.93,  "unit": "dimensionless"},
            "Warburg_sigma": {"min": 5.0, "max": 100.0, "unit": "Ω·s^-0.5"}
          },
          "CV_parameters": {
            "E_onset_methanol": {"min": 0.25, "max": 0.40, "unit": "V vs RHE", "note": "0.2V lower than pure Pt!"},
            "If_Ib_ratio":      {"min": 1.5,  "max": 3.5,  "note": "highly CO-tolerant"},
            "E_forward_peak":   {"min": 0.55, "max": 0.75, "unit": "V vs RHE"}
          },
          "recommended_circuit": "R0-p(R1,CPE1)-W1",
          "CO_poisoning_risk": "LOW",
          "mechanism": "Bifunctional: Pt oxidizes CH3OH, Ru provides OH for CO removal",
          "references": [
            "Gasteiger et al., J. Phys. Chem. 97 (1993) 12020",
            "Liu et al., J. Power Sources 175 (2008) 159"
          ]
        }
      }
    },

    "AOR_PtSn": {
